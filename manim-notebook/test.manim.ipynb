      "source": "from manim import *\n\nclass Vector123(ThreeDScene):\n    def construct(self):\n        self.set_camera_orientation(\n            phi=65 * DEGREES,\n            theta=-40 * DEGREES,\n            zoom=1.1,\n            frame_center=np.array([0.5, 1.0, 1.2]),\n        )\n\n        axes = ThreeDAxes(\n            x_range=[0, 3, 1],\n            y_range=[0, 3, 1],\n            z_range=[0, 3, 1],\n            x_length=3.5,\n            y_length=3.5,\n            z_length=3.5,\n        )\n        self.add(axes)\n\n        i_hat = Arrow3D(ORIGIN, RIGHT, color=RED)\n        j_hat = Arrow3D(ORIGIN, UP, color=GREEN)\n        k_hat = Arrow3D(ORIGIN, OUT, color=BLUE)\n\n        i_lab = MathTex(r\"\\hat{\\imath}=[1,0,0]\", color=RED).scale(0.7)\n        j_lab = MathTex(r\"\\hat{\\jmath}=[0,1,0]\", color=GREEN).scale(0.7)\n        k_lab = MathTex(r\"\\hat{k}=[0,0,1]\", color=BLUE).scale(0.7)\n\n        # Separate them in 3D so they don't collapse on screen\n        i_lab.move_to(RIGHT * 1.15 + DOWN * 0.45)\n        j_lab.move_to(UP * 1.15 + LEFT * 0.55)\n        k_lab.move_to(OUT * 1.25 + RIGHT * 0.55)\n\n        for lab in (i_lab, j_lab, k_lab):\n            lab.set_opacity(0)\n\n        self.add_fixed_orientation_mobjects(i_lab)\n        self.play(Create(i_hat), i_lab.animate.set_opacity(1))\n        self.add_fixed_orientation_mobjects(j_lab)\n        self.play(Create(j_hat), j_lab.animate.set_opacity(1))\n        self.add_fixed_orientation_mobjects(k_lab)\n        self.play(Create(k_hat), k_lab.animate.set_opacity(1))\n        self.wait()\n\n        i_comp = Arrow3D(ORIGIN, RIGHT * 1, color=RED)\n        j_comp = Arrow3D(ORIGIN, UP * 2, color=GREEN)\n        k_comp = Arrow3D(ORIGIN, OUT * 3, color=BLUE)\n\n        i_c_lab = MathTex(r\"1\\hat{\\imath}\", color=RED).scale(0.7)\n        j_c_lab = MathTex(r\"2\\hat{\\jmath}\", color=GREEN).scale(0.7)\n        k_c_lab = MathTex(r\"3\\hat{k}\", color=BLUE).scale(0.7)\n\n        # Sit beside the shaft, not on the tip\n        i_c_lab.move_to(RIGHT * 0.55 + DOWN * 0.45)\n        j_c_lab.move_to(UP * 1.1 + LEFT * 0.55)\n        k_c_lab.move_to(OUT * 1.7 + RIGHT * 0.5)\n        for lab in (i_c_lab, j_c_lab, k_c_lab):\n            lab.set_opacity(0)\n\n        self.add_fixed_orientation_mobjects(i_c_lab, j_c_lab, k_c_lab)\n        self.play(\n            Transform(i_hat, i_comp),\n            Transform(j_hat, j_comp),\n            Transform(k_hat, k_comp),\n            FadeOut(i_lab), FadeOut(j_lab), FadeOut(k_lab),\n            i_c_lab.animate.set_opacity(1),\n            j_c_lab.animate.set_opacity(1),\n            k_c_lab.animate.set_opacity(1),\n        )\n        self.wait()\n\n        j_tt = Arrow3D(RIGHT * 1, RIGHT * 1 + UP * 2, color=GREEN)\n        k_tt = Arrow3D(RIGHT * 1 + UP * 2, RIGHT * 1 + UP * 2 + OUT * 3, color=BLUE)\n        self.play(\n            Transform(j_hat, j_tt),\n            Transform(k_hat, k_tt),\n            j_c_lab.animate.move_to(RIGHT * 1.0 + UP * 1.0 + LEFT * 0.5),\n            k_c_lab.animate.move_to(RIGHT * 1.0 + UP * 2.0 + OUT * 1.6 + RIGHT * 0.5),\n        )\n        self.wait()\n\n        result = Arrow3D(ORIGIN, RIGHT * 1 + UP * 2 + OUT * 3, color=YELLOW)\n        result_lab = MathTex(\n            r\"1\\hat{\\imath}+2\\hat{\\jmath}+3\\hat{k}=\\begin{bmatrix}1\\\\2\\\\3\\end{bmatrix}\",\n            color=YELLOW,\n        ).scale(0.7)\n        result_lab.to_edge(UP)\n        result_lab.set_opacity(0)\n        self.add_fixed_in_frame_mobjects(result_lab)\n        self.play(Create(result), result_lab.animate.set_opacity(1))\n        self.wait(2)\n\n%manim -qm Vector123"
